# ============================================================
# Antigravity Bridge - .gitignore
# BLINDAGEM SOBERANA: Nenhuma credencial, token, chave ou
# dado pessoal do Cerebro Virtual deve vazar para o GitHub.
# ============================================================

# --- CREDENCIAIS E TOKENS ---
.env
.env.*
*.env
secrets/
credentials/
*.key
*.pem
*.p12
*.pfx
*.cer
*.crt
*.der

# --- CONFIGURACAO LOCAL COM TOKENS ---
# chrome.storage.sync guarda o PAT do GitHub localmente,
# mas se alguem exportar config para arquivo, bloquear:
config.json
config.local.json
settings.local.json
*.secrets.json

# --- CEREBRO VIRTUAL (AIR-GAP ABSOLUTO) ---
# NUNCA commitar estrutura interna do Cerebro Virtual
Sync_Cerebro_Global.ps1
cerebro_audit_log.jsonl
Cerebro_Virtual/
brain/
knowledge/
.gemini/
*.jsonl

# --- BRIDGE SERVER LOCAL (dados de sessao) ---
bridge_server.ps1
bridge_server_logs/
*.log
*.pid
*.lock

# --- CACHE E TEMPORARIOS ---
node_modules/
.cache/
.tmp/
*.tmp
*.bak
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# --- BUILD E DISTRIBUICAO ---
# Se gerar pacote .crx ou .zip para distribuicao
*.crx
*.zip
*.tar.gz
dist/
build/
release/

# --- LOGS DE DESENVOLVIMENTO ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDE ---
.vscode/
.idea/
*.code-workspace

# --- SISTEMA OPERACIONAL ---
.BIN/
System Volume Information/
*.lnk